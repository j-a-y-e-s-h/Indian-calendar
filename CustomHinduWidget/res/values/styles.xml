<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/md_theme_surface</item>
        <item name="android:statusBarColor">@color/md_theme_surface</item>
        <item name="android:navigationBarColor">@color/md_theme_surfaceContainer</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="M3TextHeadline">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="M3TextTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="M3TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="M3TextLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="M3TextBadge">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onPrimaryContainer</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
