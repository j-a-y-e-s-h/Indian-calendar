<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md_theme_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select City (स्थान / नगर चुनें)"
        android:textColor="@color/md_theme_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Accurate Panchang &amp; Kundali for 4,500+ global cities"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp" />

    <!-- Search Input Bar -->
    <EditText
        android:id="@+id/dialog_search_city_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/m3_card_surface"
        android:hint="Search city or country (e.g. Pune, Surat, London)..."
        android:imeOptions="actionDone"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:textColor="@color/md_theme_onSurface"
        android:textColorHint="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <!-- Results List -->
    <ListView
        android:id="@+id/dialog_city_listview"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp"
        android:divider="@color/md_theme_outlineVariant"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/dialog_btn_city_cancel"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:background="@drawable/m3_pill_indicator"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/md_theme_primary"
        android:textSize="13sp" />
</LinearLayout>
