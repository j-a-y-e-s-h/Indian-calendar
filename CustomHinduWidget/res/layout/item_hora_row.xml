<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hora_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/m3_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/hora_row_index"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="1."
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/hora_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/sun_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hora_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guru Hora (Jupiter)"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hora_row_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:text="Best for knowledge, prayer, financial deals"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hora_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06:20 - 07:18"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hora_row_nature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/m3_badge_green"
            android:text="Auspicious"
            android:textColor="@color/m3_auspicious"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
